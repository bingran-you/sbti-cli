{
  "name": "@bingran/sbti-cli",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Standalone CLI runner for the public SBTI survey.",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md"
  ],
  "bin": {
    "sbti-cli": "./dist/sbti-cli.mjs"
  },
  "scripts": {
    "build:dist": "node scripts/build-dist.mjs",
    "build:package": "npm run build:dist && node scripts/build-package.mjs",
    "start": "node src/cli.mjs",
    "sbti": "node src/cli.mjs",
    "export-images": "node scripts/export-type-images.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build:dist"
  },
  "engines": {
    "node": ">=18"
  }
}
